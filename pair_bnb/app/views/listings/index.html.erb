<h1>Upcoming LARP Events</h1>

<% if signed_in? %>
  <p>You are logged in as a <%= current_user.role.humanize.downcase %>.</p>

  <% if current_user.game_master? %>
  <%= link_to "Host a New LARP Event", new_listing_path %>
  <% end %>
  <%= link_to "Profile", edit_user_path(current_user.id) %>
  <%= link_to "My Bookings", reservations_path %>
<% end %>
<%= link_to "Find an Event", search_path %>

<div id='calendar'></div>


<table class="table">
	<thead>
		<th>Venue</th>
		<th>Region</th>
		<th>Price / day</th>
		<th>Game Master</th>
		<th>The Adventure</th>
		<th>Amenities</th>
		<th></th>
	</thead>
	<tbody>
    <% @listings.each do |listing| %>
		<tr>
			<td> <%= listing.address %></td>
			<td> <%= listing.location %></td>
			<td> <%= listing.price %></td>
			<td> <%= listing.user.email %></td>
			<td> <%= listing.description %></td>
			<td> <%= listing.amenity_names %></td>
			<td> <%= link_to "View", listing_path(id: listing.id) %></td>
		</tr>
    <% end %>
	</tbody>
</table>

<%= will_paginate @listings %>
