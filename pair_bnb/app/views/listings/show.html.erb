<%= link_to "All LARP events", listings_path %>

<table>
	<thead>
		<th>Venue</th>
		<th>Region</th>
		<th>Price / day</th>
		<th>Game Master</th>
		<th>The Adventure</th>
		<th>Amenities</th>
	</thead>
	<tbody>
	<tr>
			<td> <%= @listing.address %></td>
			<td> <%= @listing.location %></td>
			<td> <%= @listing.price %></td>
			<td> <%= @listing.user.email %></td>
			<td> <%= @listing.description %></td>
			<td> <%= @listing.amenity_names %></td>
			<% if signed_in? && current_user.game_master? %>
			<td> <%= link_to "Edit", edit_listing_path %></td>
			<td> <%= link_to "Delete", listing_path(@listing.id), method: :delete %></td>
			<% end %>
			<td> <%= link_to "Book a spot", new_listing_reservation_path(@listing.id) %></td>
	</tr>
	</tbody>
</table>
