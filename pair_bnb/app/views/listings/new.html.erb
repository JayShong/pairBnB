<h1>Host a new LARP event</h1>
  <%= form_for @listing do |form| %>
  	<div class="text-field">
 	 <%= form.label :address, "Venue address" %>
  	 <%= form.text_field :address %>
	</div>

	<div class="text-field">
 	 <%= form.label :location, "Region" %>
 	 <%= form.text_field :location %>
	</div>

	<div class="number-field">
 	 <%= form.label :price, "Price per player per day" %>
 	 <%= form.number_field :price %>
	</div>

	<div class="text-field">
 	 <%= form.label :description, "Describe the adventure" %>
 	 <%= form.text_field :description %>
	</div>

<!-- amenities offered at the event -->
	<p>What does your event provide?</p>
	<%= form.fields_for :amenitylisting do |amenity| %>
	<%= amenity.collection_check_boxes :amenity_ids, Amenity.all, :id, :name %>
	<% end %>

    <div class="submit-field">
      <%= form.submit "List this event" %>
    </div>
  <% end %>
