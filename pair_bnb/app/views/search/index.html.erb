<h1>Find a LARP event</h1>


<%= form_for @search do |form| %>
    <%= render partial: '/search/form', object: form %>

    <div class="submit-field">
      <%= form.submit "Search events" %>
    </div>
    <% end %>


<% if @listings %>
<%= flash[:notice] %>
 <table class="table">
	<thead>
		<th>Venue</th>
		<th>Region</th>
		<th>Price / day</th>
		<th>Game Master</th>
		<th>The Adventure</th>
		<th>Amenities</th>
		<th></th>
	</thead>
	<tbody>
    <% @listings.each do |listing| %>
		<tr>
			<td> <%= listing.address %></td>
			<td> <%= listing.location %></td>
			<td> <%= listing.price %></td>
			<td> <%= listing.user.email %></td>
			<td> <%= listing.description %></td>
			<td> <%= listing.amenity_names %></td>
			<td> <%= link_to "View", listing_path(id: listing.id) %></td>
		</tr>
    <% end %>
	</tbody>
</table>
<%= will_paginate @listings %>
<% end %>
