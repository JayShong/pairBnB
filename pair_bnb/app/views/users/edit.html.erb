<h1> You are logged in as <%= current_user.email %>, a <%= current_user.role.humanize.downcase %>.</h1>

<%= link_to "All LARP events", listings_path %>
<% if @user.avatars.empty? %>
<% else %>
<p><%= image_tag @user.avatars[0].thumb.url %></p>
<% end %>
<p>Upload a picture of your favourite character here</p>

  <%= form_for @user do |form| %>
  <%= form.file_field :avatars, multiple: true %>
      <%= form.submit %>
  <% end %>

<p> Switch between playing and running games here</p>
  <%= form_for @user do |form| %>
  	<% if current_user.player? %>
    	<div class="submit-field">
    	  <%= form.submit "I am a game master." %>
    	</div>
   	<% elsif current_user.game_master? %>
    	<div class="submit-field">
      	  <%= form.submit "I am a player." %>
    	</div>
    <% end %>
   <% end %>
