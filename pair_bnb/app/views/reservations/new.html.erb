
<h4><%= "Book your spot at " + @listing.address %></h4>

<% if @has_bookings %>
<p> These dates are already booked: </p>
<% @bookings.each do |booking| %>
<%= "#{booking.check_in_date}" + " to " + "#{booking.check_out_date}" %><br>
<% end %>
<% end %>
<br>
<%= form_for [@listing, @reservation] do |form| %>
    <%= render partial: '/reservations/form', object: form %>

    <div class="submit-field">
      <%= form.submit "Book my spot" %>
    </div>
<% end %>
