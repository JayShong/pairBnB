{
  "name": "guildhall",
  "version": "1.0.0",
  "private": true,
  "description": "Guildhall — the gathering place for your LARP community. Events, characters, and bookings.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "next lint",
    "db:migrate:local": "wrangler d1 migrations apply guildhall --local",
    "db:migrate:remote": "wrangler d1 migrations apply guildhall --remote",
    "db:seed:local": "wrangler d1 execute guildhall --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute guildhall --remote --file=./seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.20.0"
  }
}
